# =================================================================
# PREDICTIVE DEVOPS INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION
# =================================================================

# Application Settings
APP_NAME="Predictive DevOps Intelligence Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-to-a-cryptographically-random-32-byte-secret

# PostgreSQL Database (Async & Sync for Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/devops_intelligence
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/devops_intelligence

# Redis Streams Event Bus
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_EVENTS=stream:devops:events
REDIS_STREAM_DEAD_LETTER=stream:devops:deadletter
REDIS_CONSUMER_GROUP=group:devops:intelligence
REDIS_CONSUMER_NAME=worker-1

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=test-github-webhook-secret
GITHUB_API_TOKEN=

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
